# Copie este arquivo para ".env" e preencha os valores:
#   cp .env.example .env
# O arquivo ".env" NÃO deve ser commitado.

# URL de conexão com o banco (formato do SQLAlchemy).

# PostgreSQL (requer o driver psycopg instalado):
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/ecommerce

# SQLite (apenas para testes locais rápidos):
# DATABASE_URL=sqlite:///./ecommerce.db

# Chave usada para assinar os tokens JWT.
# Gere uma chave aleatória com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Algoritmo de assinatura do JWT.
ALGORITHM=HS256

# Tempo de vida do token de acesso, em minutos.
ACCESS_TOKEN_TIME=30
